NODE_ENV=production
PORT=4000
API_URL=https://api-crm.example.com
FRONTEND_URL=https://your-crm.vercel.app
API_DOMAIN=api-crm.example.com
CORS_ORIGINS=https://your-crm.vercel.app

# Generate independent values with: openssl rand -hex 32
JWT_SECRET=CHANGE_TO_A_RANDOM_64_CHARACTER_HEX_VALUE
JWT_EXPIRES_IN=10h
REFRESH_EXPIRES_IN=10h

POSTGRES_DB=cresco_prod
POSTGRES_USER=cresco_app
POSTGRES_PASSWORD=CHANGE_TO_A_RANDOM_64_CHARACTER_HEX_VALUE
DB_HOST=db
DB_PORT=5432
DB_NAME=cresco_prod
DB_USER=cresco_app
DB_PASSWORD=CHANGE_TO_THE_SAME_VALUE_AS_POSTGRES_PASSWORD

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=help.cresco@gmail.com
SMTP_PASS=REPLACE_WITH_A_NEW_GMAIL_APP_PASSWORD
SMTP_FROM=Cresco CRM <help.cresco@gmail.com>
