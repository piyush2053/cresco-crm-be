{
  "name": "crm-cresco-be",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/nodemon/bin/nodemon.js src/index.js",
    "start": "node src/index.js",
    "check": "node --check src/index.js && node --check src/config.js && node --check scripts/initial-data-load.js && node --check scripts/database-backup.js",
    "initial-data:template": "node --env-file-if-exists=.env scripts/initial-data-load.js template",
    "initial-data:validate": "node --env-file-if-exists=.env scripts/initial-data-load.js validate",
    "initial-data:import": "node --env-file-if-exists=.env scripts/initial-data-load.js import"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.4",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
